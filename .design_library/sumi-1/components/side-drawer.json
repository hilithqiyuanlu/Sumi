{
  "slug": "side-drawer",
  "name": "Side Drawer",
  "category": "navigation",
  "description": "左侧抽屉导航，包含用户信息、项目列表和设置入口。",
  "preview": "component-side-drawer.html",
  "tokens": {
    "width": "280px",
    "background": "$surface-alt",
    "border-radius-right": "$radius-card",
    "section-spacing": {
      "top": "20px",
      "between": "16px",
      "bottom": "20px"
    },
    "padding-horizontal": "16px"
  },
  "sections": {
    "user-header": {
      "description": "顶部用户信息区域，含头像和用户名",
      "layout": "column",
      "align": "center",
      "padding-top": "24px",
      "padding-bottom": "20px",
      "avatar": {
        "size": "56px",
        "shape": "circle",
        "background": "$project-color"
      },
      "username": {
        "font-size": "16px",
        "font-weight": "$font-weight-semibold",
        "color": "$text-primary",
        "margin-top": "8px"
      }
    },
    "project-list": {
      "description": "项目列表，每个项目以 pill 形式展示",
      "layout": "column",
      "spacing": "8px",
      "item": {
        "type": "pill",
        "height": "36px",
        "border-radius": "$radius-pill",
        "background": "$project-color-25",
        "padding-horizontal": "12px",
        "text": {
          "font-size": "14px",
          "font-weight": "$font-weight-medium",
          "color": "$text-primary"
        }
      }
    },
    "settings-entry": {
      "description": "底部设置入口",
      "layout": "card",
      "border-radius": "$radius-12",
      "background": "$surface",
      "padding": "12px 16px",
      "margin-bottom": "16px",
      "text": {
        "font-size": "14px",
        "font-weight": "$font-weight-medium",
        "color": "$text-secondary"
      }
    }
  },
  "interactions": {
    "open": {
      "type": "slide-in",
      "direction": "left",
      "duration": "250ms",
      "curve": "$ease-out"
    },
    "close": {
      "type": "slide-out",
      "direction": "left",
      "duration": "200ms",
      "curve": "$ease-in",
      "triggers": ["tap-outside", "swipe-left"]
    }
  }
}